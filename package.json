{
  "name": "recognize_cctv_fe",
  "version": "0.1.0",
  "private": true,
  "description": "Local CCTV visitor counter with FastAPI and Next.js",
  "author": "Duluin",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "desktop:dev": "node scripts/desktop/dev.cjs",
    "desktop:test": "node --test tests/desktop-*.test.cjs",
    "desktop:assets": "node scripts/desktop/prepare.cjs",
    "desktop:clean": "node scripts/desktop/clean.cjs",
    "desktop:build": "node scripts/desktop/build.cjs",
    "desktop:rebuild": "node scripts/desktop/rebuild.cjs",
    "desktop:package": "electron-builder --config electron-builder.cjs --publish never",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "framer-motion": "^13.2.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.40.0",
    "next": "^16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }

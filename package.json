{
  "name": "recognize_cctv_fe",
  "version": "0.1.0",
  "private": true,
  "description": "Local CCTV visitor counter with FastAPI and Next.js",
  "author": "Duluin",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "desktop:dev": "node scripts/tauri/run.cjs dev",
    "desktop:test": "node --test tests/desktop-*.test.cjs tests/tauri-*.test.cjs",
    "desktop:assets": "node scripts/desktop/prepare.cjs",
    "desktop:clean": "node scripts/desktop/clean.cjs",
    "desktop:build": "node scripts/tauri/run.cjs build",
    "test": "node --test tests/*.test.mjs",
    "docs:build": "node scripts/docs/render.cjs",
    "docs:capture": "node scripts/docs/capture.cjs && node scripts/docs/install-assets.cjs",
    "docs:check": "node --test tests/manual-docs.test.cjs tests/docs-chromium.test.cjs",
    "docs:assets": "node scripts/docs/install-assets.cjs",
    "docs:generate": "node scripts/docs/generate.cjs",
    "tauri:dev": "node scripts/tauri/run.cjs dev",
    "tauri:build": "node scripts/tauri/run.cjs build",
    "tauri:check": "node --test tests/tauri-*.test.cjs",
    "desktop:resources": "node scripts/desktop/build-wrapper.cjs",
    "desktop:package": "node scripts/tauri/run.cjs package"
  },
  "dependencies": {
    "framer-motion": "^13.2.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.40.0",
    "next": "^16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

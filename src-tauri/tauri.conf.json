{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Visitor Counter",
  "version": "../package.json",
  "identifier": "com.duluin.visitorcounter",
  "build": {
    "frontendDist": "bootstrap",
    "beforeBundleCommand": "node scripts/tauri/validate-resources.cjs"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "resources": {
      "../tauri/": "runtime/tauri/",
      "../desktop/runtime.cjs": "runtime/desktop/runtime.cjs",
      "../desktop/auth-session.cjs": "runtime/desktop/auth-session.cjs",
      "../desktop/camera-network.cjs": "runtime/desktop/camera-network.cjs",
      "../scripts/desktop/python-path.cjs": "runtime/scripts/desktop/python-path.cjs",
      "../package.json": "runtime/package.json",
      "../desktop/profile-lock.cjs": "runtime/desktop/profile-lock.cjs"
    },
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

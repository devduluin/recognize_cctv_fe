{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Visitor Counter",
  "version": "../package.json",
  "identifier": "com.duluin.visitorcounter",
  "build": {
    "frontendDist": "bootstrap"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "resources": {
      "../resources/": "runtime/resources/",
      "../tauri/": "runtime/tauri/",
      "../electron/runtime.cjs": "runtime/electron/runtime.cjs",
      "../electron/auth-session.cjs": "runtime/electron/auth-session.cjs",
      "../electron/camera-network.cjs": "runtime/electron/camera-network.cjs",
      "../scripts/desktop/python-path.cjs": "runtime/scripts/desktop/python-path.cjs",
      "../package.json": "runtime/package.json",
      "../electron/profile-lock.cjs": "runtime/electron/profile-lock.cjs"
    },
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
